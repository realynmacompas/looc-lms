+  function renderSummary(data) {
+    const students = data.students || [];
+    const assignments = data.assignments || [];
+
+    const graded = students.map((s) => s.percent).filter((p) => p > 0);
+    const classAverage = graded.length
+      ? (graded.reduce((sum, p) => sum + p, 0) / graded.length).toFixed(1) + "%"
+      : "—";
+
+    const fullyGraded = assignments.filter((a) =>
+      students.length > 0 &&
+      students.every((s) => (s.grades || []).find((g) => g.assignmentId === a.assignmentId)?.status === "graded")
+    ).length;
+
+    document.getElementById("statClassAverage").textContent = classAverage;
+    document.getElementById("statStudentCount").textContent = data.totalStudents ?? students.length;
+    document.getElementById("statAssignmentsGraded").textContent = `${fullyGraded} / ${assignments.length}`;
+  }
